# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright
/test-results
/playwright-report
/blob-report
/playwright/.cache
# server-side state sandbox used by the local test target
/.playwright-state

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# FlowState sync state (local runtime state — never committed)
.flowstate-state.json
.flowstate-setup.json
.flowstate-ide-connection.json
.flowstate-ide-connection-history.json
.env*.local
